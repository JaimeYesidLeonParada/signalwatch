{
  "version": 3,
  "configurePresets": [
    {
      "name": "host-tests",
      "displayName": "Host tests (gcc MSYS2 + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe"
      },
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;C:/Espressif/tools/ninja/1.12.1;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-tests", "configurePreset": "host-tests" }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": { "outputOnFailure": true }
    }
  ]
}
